          "scheme": "light", "ground": "brand.sage", "fg": "brand.ink", "muted": "brand.ink", "line": "mix(brand.ink,brand.sage,32)",
          "tone": "mix(brand.paper,brand.sage,18)", "field": "brand.paper", "link": "brand.ink", "linkLarge": "brand.forest", "control": "brand.ink", "focus": "brand.ink",
          "primary": "brand.ink", "onPrimary": "brand.paper", "primaryHover": "brand.forest", "onPrimaryHover": "brand.paper",
          "code": "brand.ink", "onCode": "brand.paper",
          "success": "brand.ink", "warn": "brand.ink", "danger": "brand.ink", "onDanger": "brand.paper", "info": "brand.ink", "hues": "light"
        }
