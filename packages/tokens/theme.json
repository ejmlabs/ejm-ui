  "contrast": {
    "note": "Minimum ratios the generator enforces. Text roles must reach 4.5:1 on every surface they appear on; subtle text and borders only need 3:1.",
    "text": ["text", "text-strong", "text-muted", "accent", "error", "warning", "success", "special", "info"],
    "controlBorder": { "role": "control-border", "min": 3, "surfaces": ["ground", "panel", "editor", "raised"] },
    "surfaces": ["ground", "panel", "editor", "raised", "overlay"],
    "syntaxMin": 4.5,
    "subtleMin": 3,
    "board": {
      "note": "The chessboard follows the page theme, never a band. Its pieces are fixed art: black pieces and the outline of every piece are pure black. pieces: black against each square, so every outline and black piece shows. mark: coordinates and move markers against each square. squares: the two squares against each other, so the checkerboard reads without the labels.",
      "pieces": 3,
      "mark": 3,
      "squares": 1.4
    },
    "web": {
      "note": "Gates for every web band (Paper, Mist, Sage, Ink) in both themes. text: fg, muted, link, status and on-colors on their grounds. large: link-large, for display type only. control: control borders against the ground and the field. focus: the focus ring. graphic: the six hues, as chart marks. line: hairlines only need to be visible, they do not carry meaning alone, so they are held to 1.4 and not 3.",
      "text": 4.5,
      "large": 3,
      "control": 3,
      "focus": 3,
      "graphic": 3,
      "line": 1.4,
      "noHues": ["sage"]
    }
  },
  "web": {
    "note": "Web bands. Every band sets the same variables, so a component only ever reads ground, fg, muted, line and the rest. A value is brand.NAME, light.ROLE or dark.ROLE (a role of the ui theme above), light.hue1 to hue6, mix(A,B,N) for N percent of A over B, or a literal. A band with no dark entry is the same in both themes: Sage always stays Sage, Ink always stays Ink. Sage text is Ink only: Ink on Sage is the one pair that reaches 4.5:1, so muted text and links on Sage are Ink too, and Forest on Sage (3.5:1) is allowed for large type only (link-large).",
    "keys": ["scheme", "ground", "fg", "muted", "line", "tone", "field", "link", "linkLarge", "control", "focus", "primary", "onPrimary", "primaryHover", "onPrimaryHover", "code", "onCode", "success", "warn", "danger", "onDanger", "info", "hues"],
    "elevation": {
      "note": "Three levels, used only by product windows, menus and overlays. {ink/10} is Ink at 10 percent, {black/40} black at 40 percent, {paper/6} Paper at 6 percent. The dark values are deeper and add a faint top edge of light so a window still separates from a dark ground.",
      "light": {
        "rest": "0 1px 2px {ink/10}, 0 8px 16px -8px {ink/18}",
        "raised": "0 2px 4px {ink/8}, 0 12px 24px -8px {ink/18}, 0 24px 48px -24px {ink/24}",
        "float": "0 4px 8px {ink/8}, 0 24px 48px -12px {ink/22}, 0 48px 96px -32px {ink/34}"
      },
      "dark": {
        "rest": "inset 0 1px 0 {paper/6}, 0 1px 2px {black/40}, 0 8px 16px -8px {black/55}",
        "raised": "inset 0 1px 0 {paper/8}, 0 2px 4px {black/35}, 0 12px 24px -8px {black/55}, 0 24px 48px -24px {black/65}",
        "float": "inset 0 1px 0 {paper/10}, 0 4px 8px {black/35}, 0 24px 48px -12px {black/60}, 0 48px 96px -32px {black/70}"
      }
    },
    "bands": {
      "paper": {
        "light": {
          "scheme": "light", "ground": "brand.paper", "fg": "brand.ink", "muted": "mix(brand.ink,brand.paper,72)", "line": "mix(brand.ink,brand.paper,22)",
          "tone": "brand.mist", "field": "brand.white", "link": "brand.forest", "linkLarge": "brand.forest", "control": "light.control-border", "focus": "brand.forest",
          "primary": "brand.sage", "onPrimary": "brand.ink", "primaryHover": "brand.forest", "onPrimaryHover": "brand.paper",
          "code": "brand.forest", "onCode": "brand.paper",
          "success": "light.success", "warn": "light.warning", "danger": "light.error", "onDanger": "brand.paper", "info": "light.info", "hues": "light"
        },
        "dark": {
