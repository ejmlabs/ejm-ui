          "tone": "brand.paper", "field": "brand.white", "link": "brand.forest", "linkLarge": "brand.forest", "control": "light.control-border", "focus": "brand.forest",
          "primary": "brand.sage", "onPrimary": "brand.ink", "primaryHover": "brand.forest", "onPrimaryHover": "brand.paper",
          "code": "brand.forest", "onCode": "brand.paper",
          "success": "light.success", "warn": "light.warning", "danger": "light.error", "onDanger": "brand.paper", "info": "light.info", "hues": "light"
        },
        "dark": {
          "scheme": "dark", "ground": "dark.editor", "fg": "dark.text", "muted": "dark.text-muted", "line": "dark.line-strong",
          "tone": "dark.overlay", "field": "dark.ground", "link": "dark.accent", "linkLarge": "dark.accent", "control": "dark.control-border", "focus": "dark.focus",
          "primary": "brand.sage", "onPrimary": "brand.ink", "primaryHover": "mix(brand.sage,brand.paper,70)", "onPrimaryHover": "brand.ink",
          "code": "dark.ground", "onCode": "dark.text",
          "success": "dark.success", "warn": "dark.warning", "danger": "dark.error", "onDanger": "brand.ink", "info": "dark.info", "hues": "dark"
