{
  "name": "@ejm/ssg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tiny prerender package: every route of a Vite and React SPA becomes static HTML at build time, then hydrates.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "ejm-ssg": "./bin/ejm-ssg.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./vite": "./src/vite.mjs",
    "./budget": "./src/budget.mjs",
    "./ssg.css": "./src/ssg.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.*",
    "!src/perf",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "wouter": "^3.13.0"
  }
}
