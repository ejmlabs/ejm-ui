{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "react": ["../../../node_modules/@types/react", "../../../@types/react"],
      "react/*": ["../../../node_modules/@types/react/*", "../../../@types/react/*"],
      "react-dom": ["../../../node_modules/@types/react-dom", "../../../@types/react-dom"],
      "react-dom/*": ["../../../node_modules/@types/react-dom/*", "../../../@types/react-dom/*"],
      "vite": ["../../../node_modules/vite/dist/node/index.d.ts", "../../../vite/dist/node/index.d.ts"],
      "vite/*": ["../../../node_modules/vite/*", "../../../vite/*"]
    }
  }
}
