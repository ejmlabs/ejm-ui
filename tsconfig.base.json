{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@ejm/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@ejm/ui/*": [
        "./packages/ui/src/*"
      ],
      "@ejm/tokens": [
        "./packages/tokens/src/index.ts"
      ],
      "@ejm/demos": [
        "./packages/demos/src/index.ts"
      ]
    }
  }
}
